# Copy this file to ".env.local" for local development. Never commit real values.

# ---- Browser (public) — safe to expose; protected by Row Level Security ----
# Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase → Project Settings → API → anon / publishable key
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Optional: set to "local" to force the browser-only demo mode
# VITE_DATA_MODE=local

# ---- Server only (Vercel functions in /api) — SECRET, never prefix with VITE_ ----
# Same Project URL as above
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase → Project Settings → API → service_role / secret key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
